{
  "name": "skoolledger",
  "version": "0.1.0",
  "private": true,
  "description": "SkoolLedger — Fees • Payroll • Inventory • Accounts. Locally installable school finance and operations software.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @skoolledger/shared build && pnpm -r --parallel --filter \"./apps/*\" --filter @skoolledger/shared dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter @skoolledger/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @skoolledger/shared build && pnpm -r test",
    "test:e2e": "pnpm --filter @skoolledger/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @skoolledger/api prisma:migrate",
    "db:deploy": "pnpm --filter @skoolledger/api prisma:deploy",
    "db:seed": "pnpm --filter @skoolledger/api prisma:seed",
    "db:studio": "pnpm --filter @skoolledger/api prisma:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
