# =====================================================================
#  SkoolLedger configuration
#  Copy this file to `.env` in the repository root and fill in the
#  REQUIRED values. Never commit `.env` or share it.
#
#  SkoolLedger runs with plain Node.js + PostgreSQL. Docker is optional
#  (see the "Optional: Docker" section at the end).
# =====================================================================

# --- Environment ------------------------------------------------------
# development | production
NODE_ENV=development

# --- Addresses --------------------------------------------------------
# Public address schools open in their browser (used in logs/links).
# Development: http://localhost:5173   Production: https://app.example.com
APP_URL=http://localhost:5173
# Port the Node.js API listens on.
API_PORT=3000
# Production: path to the built web app (apps/web/dist). When set, the API
# also serves the web app, so ONE Node.js process runs all of SkoolLedger
# on a single origin. Leave empty in development (Vite serves the web app
# on :5173 and proxies /api to the API).
WEB_DIST_DIR=
# Express "trust proxy": `loopback` when a reverse proxy (Nginx/Caddy) on the
# same machine terminates HTTPS; `1` for one proxy hop elsewhere.
TRUST_PROXY=loopback
# Set to true once SkoolLedger is served over HTTPS (required in production).
COOKIE_SECURE=false
# Extra allowed browser origins (comma separated). Leave empty: the web app
# and API are served from the same address.
CORS_ORIGINS=

# --- Database (PostgreSQL) --------------------------------------------
# REQUIRED. Any PostgreSQL 14+ server (local, VPS, or a managed service).
DATABASE_URL=postgresql://skoolledger:change-me-postgres-password@localhost:5432/skoolledger?schema=public

# --- Security ---------------------------------------------------------
# REQUIRED: at least 32 random characters. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- File storage -----------------------------------------------------
# `local` stores uploads on the server's disk under UPLOAD_DIR. An
# S3-compatible driver is planned; no paid storage service is required.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
LOGO_MAX_BYTES=1048576

# --- First-run setup (used only when the database is empty) ------------
INITIAL_SCHOOL_NAME=My School
INITIAL_CURRENCY=PKR
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@skoolledger.local
INITIAL_ADMIN_USERNAME=admin
# Leave empty to have a strong password generated and printed once by
# `pnpm db:seed`. It must be changed at first sign-in.
INITIAL_ADMIN_PASSWORD=

# --- Backups ----------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30

# --- Optional: Docker (docker-compose.yml only) ------------------------
# Ignored when running with plain Node.js.
HTTP_PORT=80
POSTGRES_DB=skoolledger
POSTGRES_USER=skoolledger
POSTGRES_PASSWORD=change-me-postgres-password
