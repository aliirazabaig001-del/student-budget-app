# =====================================================================
#  SkoolLedger configuration
#  Copy this file to `.env` (the installer scripts do this for you and
#  fill in random secrets). Never commit `.env` or share it.
# =====================================================================

# --- Web access -------------------------------------------------------
# Port on this computer that browsers connect to. 80 lets staff type
# http://<server-ip> with no port. Change it (e.g. 8080) if 80 is taken.
HTTP_PORT=80
# Set to true only when SkoolLedger is served over HTTPS.
COOKIE_SECURE=false

# --- Database (PostgreSQL) --------------------------------------------
POSTGRES_DB=skoolledger
POSTGRES_USER=skoolledger
# REQUIRED: long random value. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres-password
# Used by the API. In Docker the host is `db`; for local development use localhost.
DATABASE_URL=postgresql://skoolledger:change-me-postgres-password@localhost:5432/skoolledger?schema=public

# --- Security ---------------------------------------------------------
# REQUIRED: at least 32 random characters. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- API --------------------------------------------------------------
API_PORT=3000
NODE_ENV=production
# `1` behind the bundled Nginx container; `loopback` for local development.
TRUST_PROXY=1
# Extra allowed browser origins (comma separated). Leave empty: the web app
# and API are served from the same address by Nginx.
CORS_ORIGINS=

# --- File storage -----------------------------------------------------
UPLOAD_DIR=./uploads
LOGO_MAX_BYTES=1048576

# --- First-run setup (used only when the database is empty) ------------
INITIAL_SCHOOL_NAME=My School
INITIAL_CURRENCY=PKR
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@skoolledger.local
INITIAL_ADMIN_USERNAME=admin
# Leave empty to have a strong password generated and printed once in the
# API log (docker compose logs api). You must change it at first sign-in.
INITIAL_ADMIN_PASSWORD=

# --- Backups ----------------------------------------------------------
# Folder where backup scripts write files. Can be a USB drive path.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
